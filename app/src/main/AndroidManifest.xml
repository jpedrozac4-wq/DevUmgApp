<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusApp">

        <activity
            android:name=".auth.ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.ui.HomeActivity"
            android:exported="false"
            android:parentActivityName=".auth.ui.LoginActivity" />

        <activity
            android:name=".auth.ui.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".auth.ui.HomeActivity" />

        <activity
            android:name=".carrera.ui.CarreraListActivity"
            android:exported="false" />

        <activity
            android:name=".carrera.ui.CarreraFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".curso.ui.CursoListActivity"
            android:exported="false" />

        <activity
            android:name=".curso.ui.CursoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".inscripcion.ui.InscripcionListActivity"
            android:exported="false" />

        <activity
            android:name=".inscripcion.ui.InscripcionFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".inscripcion.ui.InscripcionDetailActivity"
            android:exported="false" />

        <activity
            android:name=".nota.ui.NotaListActivity"
            android:exported="false" />

        <activity
            android:name=".nota.ui.NotaFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".nota.ui.PromedioNotasActivity"
            android:exported="false" />

        <activity
            android:name=".colegiatura.ui.ColegiaturaListActivity"
            android:exported="false" />

        <activity
            android:name=".colegiatura.ui.ColegiaturaFormActivity"
            android:exported="false" />

        <activity
            android:name=".colegiatura.ui.PagoColegiaturaActivity"
            android:exported="false" />

        <activity
            android:name=".estudiante.ui.EstudianteListActivity"
            android:exported="false" />

        <activity
            android:name=".estudiante.ui.EstudianteFormActivity"
            android:exported="false" />

        <activity
            android:name=".estudiante.ui.EstudianteDetailActivity"
            android:exported="false" />

        <activity
            android:name=".docente.ui.DocenteListActivity"
            android:exported="false" />

        <activity
            android:name=".docente.ui.DocenteFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Módulo de Usuarios, Roles y Permisos -->
        <activity
            android:name=".usuario.ui.UsuarioListActivity"
            android:exported="false" />

        <activity
            android:name=".usuario.ui.UsuarioFormActivity"
            android:exported="false" />

        <activity
            android:name=".usuario.ui.UsuarioRolesActivity"
            android:exported="false" />

        <activity
            android:name=".rol.ui.RolListActivity"
            android:exported="false" />

        <activity
            android:name=".rol.ui.RolFormActivity"
            android:exported="false" />

        <activity
            android:name=".permiso.ui.PermisoListActivity"
            android:exported="false" />

        <activity
            android:name=".permiso.ui.PermisoFormActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="gt.com.ro.devumgapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
