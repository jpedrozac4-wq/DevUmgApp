<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_screen"
    tools:context=".rol.ui.RolFormActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRolForm"
        android:layout_width="0dp"
        android:layout_height="@dimen/dashboard_header_height"
        android:background="@color/dashboard_surface"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/rol_form_titulo"
        app:titleTextColor="@color/dashboard_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/rol_volver"/>

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarRolForm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_screen_padding">

            <!-- Hero/banner -->
            <LinearLayout
                android:id="@+id/rolFormHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rol_header"
                android:gravity="center_vertical"
                android:minHeight="116dp"
                android:orientation="horizontal"
                android:padding="@dimen/dashboard_card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRolFormHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/rol_form_titulo_crear"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/rol_form_subtitulo"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="14sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.9"
                    android:src="@drawable/ic_badge"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:tint="@color/white"/>
            </LinearLayout>

            <!-- Card con formulario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRolForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/dashboard_surface"
                app:cardCornerRadius="@dimen/dashboard_card_radius"
                app:cardElevation="4dp"
                app:strokeColor="@color/dashboard_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dashboard_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/rol_form_datos_titulo"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <!-- Campo Código -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRolCodigo"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/rol_codigo_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_rol"
                        app:hintTextColor="@color/dashboard_rol"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/dashboard_rol">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRolCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:maxLength="50"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRolNombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/rol_nombre_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_rol"
                        app:hintTextColor="@color/dashboard_rol"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/dashboard_rol">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRolNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:maxLength="100"
                            android:maxLines="2"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Descripción -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRolDescripcion"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/rol_descripcion_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_rol"
                        app:counterEnabled="true"
                        app:counterMaxLength="300"
                        app:hintTextColor="@color/dashboard_rol"
                        app:startIconDrawable="@drawable/ic_description"
                        app:startIconTint="@color/dashboard_rol">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRolDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="300"
                            android:minLines="3"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Asignación de permisos -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/rol_permisos_titulo"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtPermisosRolAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/rol_permisos_ayuda"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtRolPermisosNota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/rol_permisos_nota_inactivo"
                        android:textColor="@color/dashboard_accent"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <TextView
                        android:id="@+id/txtRolPermisosSeleccionados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/dashboard_rol"
                        android:textSize="14sp"
                        tools:text="4 permisos seleccionados" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBuscarPermisoRol"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/rol_permisos_buscar_hint"
                        app:boxStrokeColor="@color/dashboard_rol"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="@color/dashboard_rol">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtBuscarPermisoRol"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtRolPermisosVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/rol_permisos_vacio"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPermisosRol"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingBottom="8dp"
                        tools:listitem="@layout/item_permission_select" />

                    <!-- Botón Guardar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarRol"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="20dp"
                        android:text="@string/rol_btn_guardar"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/dashboard_rol"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"/>

                    <!-- Botón Cancelar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelarRol"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="8dp"
                        android:text="@string/rol_btn_cancelar"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressRolForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/dashboard_primary"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
