<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_screen"
    tools:context=".usuario.ui.UsuarioRolesActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUsuarioRoles"
        android:layout_width="0dp"
        android:layout_height="@dimen/dashboard_header_height"
        android:background="@color/dashboard_surface"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/usuario_roles_titulo"
        app:titleTextColor="@color/dashboard_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/usuario_volver"/>

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarUsuarioRoles"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_screen_padding">

            <!-- Hero/banner -->
            <LinearLayout
                android:id="@+id/usuarioRolesHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_usuario_header"
                android:gravity="center_vertical"
                android:minHeight="116dp"
                android:orientation="horizontal"
                android:padding="@dimen/dashboard_card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtUsuarioRolesHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/usuario_roles_titulo"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/usuario_roles_subtitulo"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="14sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.9"
                    android:src="@drawable/ic_users"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:tint="@color/white"/>
            </LinearLayout>

            <!-- Card con la asignación de roles -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUsuarioRoles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/dashboard_surface"
                app:cardCornerRadius="@dimen/dashboard_card_radius"
                app:cardElevation="4dp"
                app:strokeColor="@color/dashboard_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dashboard_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/usuario_roles_titulo"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtUsuarioRolesAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/usuario_roles_ayuda"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtUsuarioRolesNota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/usuario_roles_nota_inactivo"
                        android:textColor="@color/dashboard_accent"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <TextView
                        android:id="@+id/txtUsuarioRolesVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/usuario_roles_vacio"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <LinearLayout
                        android:id="@+id/layoutRoles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"/>

                    <!-- Botón Guardar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="20dp"
                        android:text="@string/usuario_btn_guardar_roles"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/dashboard_users"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"/>

                    <!-- Botón Cancelar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="8dp"
                        android:text="@string/usuario_btn_cancelar"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressUsuarioRoles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/dashboard_users"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
