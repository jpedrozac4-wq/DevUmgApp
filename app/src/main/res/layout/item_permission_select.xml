<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:layout_marginEnd="4dp" android:layout_marginBottom="3dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/dashboard_surface" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="@color/dashboard_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="9dp" android:paddingEnd="8dp" android:paddingBottom="9dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtPermissionName" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/dashboard_text_primary" android:textSize="15sp" />
            <TextView android:id="@+id/txtPermissionCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="monospace" android:textColor="@color/dashboard_text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/chkPermission" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:buttonTint="@color/dashboard_rol" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
