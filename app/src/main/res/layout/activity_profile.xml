<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_screen"
    tools:context=".auth.ui.ProfileActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profileToolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/dashboard_header_height"
        android:background="@color/dashboard_surface"
        android:elevation="1dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/profile_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/profile_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        app:titleTextColor="@color/dashboard_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/dashboard_screen_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/dashboard_screen_padding"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dashboard_primary"
                app:cardCornerRadius="@dimen/dashboard_header_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/txtProfileAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_dashboard_avatar_light"
                        android:contentDescription="@string/dashboard_avatar_description"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/dashboard_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="A" />

                    <TextView
                        android:id="@+id/txtProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="Andrea López" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/profile_account_subtitle"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/profileProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/dashboard_primary" />

            <TextView
                android:id="@+id/txtProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/dashboard_primary_light"
                android:padding="12dp"
                android:textColor="@color/dashboard_error"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="No se pudo actualizar el perfil." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileRetry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/profile_retry"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/profile_information"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/dashboard_surface"
                app:cardCornerRadius="@dimen/dashboard_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/dashboard_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView style="@style/ProfileLabel" android:text="@string/profile_user_id" />
                    <TextView android:id="@+id/txtProfileUserId" style="@style/ProfileValue" tools:text="42" />
                    <View style="@style/ProfileDivider" />
                    <TextView style="@style/ProfileLabel" android:text="@string/profile_username" />
                    <TextView android:id="@+id/txtProfileUsername" style="@style/ProfileValue" tools:text="admin" />
                    <View style="@style/ProfileDivider" />
                    <TextView style="@style/ProfileLabel" android:text="@string/profile_email" />
                    <TextView android:id="@+id/txtProfileEmail" style="@style/ProfileValue" android:autoLink="email" tools:text="admin@sgau.test" />
                    <View style="@style/ProfileDivider" />
                    <TextView style="@style/ProfileLabel" android:text="@string/profile_roles" />
                    <TextView android:id="@+id/txtProfileRoles" style="@style/ProfileValue" tools:text="ADMIN, DOCENTE" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/profile_security"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_edit_action"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePassword"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_password_action"
                app:icon="@drawable/ic_lock"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/profile_actions_note"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
