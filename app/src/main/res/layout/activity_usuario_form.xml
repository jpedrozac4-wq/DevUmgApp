<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_screen"
    tools:context=".usuario.ui.UsuarioFormActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUsuarioForm"
        android:layout_width="0dp"
        android:layout_height="@dimen/dashboard_header_height"
        android:background="@color/dashboard_surface"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/usuario_form_titulo"
        app:titleTextColor="@color/dashboard_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/usuario_volver"/>

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarUsuarioForm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_screen_padding">

            <!-- Hero/banner -->
            <LinearLayout
                android:id="@+id/usuarioFormHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_usuario_header"
                android:gravity="center_vertical"
                android:minHeight="116dp"
                android:orientation="horizontal"
                android:padding="@dimen/dashboard_card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtUsuarioFormHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/usuario_form_titulo_crear"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/usuario_form_subtitulo"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="14sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.9"
                    android:src="@drawable/ic_user"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:tint="@color/white"/>
            </LinearLayout>

            <!-- Card con formulario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUsuarioForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/dashboard_surface"
                app:cardCornerRadius="@dimen/dashboard_card_radius"
                app:cardElevation="4dp"
                app:strokeColor="@color/dashboard_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dashboard_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/usuario_form_datos_titulo"
                        android:textColor="@color/dashboard_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <!-- Campo Usuario -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuarioUsername"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/usuario_username_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_users"
                        app:hintTextColor="@color/dashboard_users"
                        app:startIconDrawable="@drawable/ic_user"
                        app:startIconTint="@color/dashboard_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUsuarioUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="50"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuarioEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/usuario_email_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_users"
                        app:hintTextColor="@color/dashboard_users"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/dashboard_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUsuarioEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuarioPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/usuario_password_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_users"
                        app:hintTextColor="@color/dashboard_users"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/dashboard_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUsuarioPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuarioNombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/usuario_nombre_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_users"
                        app:hintTextColor="@color/dashboard_users"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/dashboard_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUsuarioNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:maxLength="100"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Apellido -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuarioApellido"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/usuario_apellido_hint"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/dashboard_users"
                        app:hintTextColor="@color/dashboard_users"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/dashboard_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUsuarioApellido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLength="100"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/dashboard_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:id="@+id/txtUsuarioPerfilTitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="22dp" android:fontFamily="sans-serif-black" android:text="Rol"
                        android:textColor="@color/dashboard_text_primary" android:textSize="17sp" android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtUsuarioRolesAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Selecciona un rol activo. Los perfiles académicos aparecen según el rol elegido."
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/layoutUsuarioRoles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/txtUsuarioRolesEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/dashboard_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout android:id="@+id/panelUsuarioDocente" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioCodigoDocente"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Código docente">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioCodigoDocente"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioTelefonoDocente" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Teléfono">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioTelefonoDocente"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioEspecialidadDocente" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Especialidad">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioEspecialidadDocente"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/panelUsuarioEstudiante" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioCodigoEstudiante"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Código estudiantil">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioCodigoEstudiante"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioIdentificacionEstudiante"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Número de identificación">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioIdentificacionEstudiante"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioFechaEstudiante"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Fecha de nacimiento (AAAA-MM-DD)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioFechaEstudiante"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioTelefonoEstudiante" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Teléfono">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioTelefonoEstudiante"
                                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilUsuarioDireccionEstudiante" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Dirección">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtUsuarioDireccionEstudiante"
                                android:layout_width="match_parent" android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Botón Guardar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarUsuario"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="20dp"
                        android:text="@string/usuario_btn_guardar"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/dashboard_users"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"/>

                    <!-- Botón Cancelar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelarUsuario"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_button_height"
                        android:layout_marginTop="8dp"
                        android:text="@string/usuario_btn_cancelar"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressUsuarioForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/dashboard_users"
                        tools:visibility="visible"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
