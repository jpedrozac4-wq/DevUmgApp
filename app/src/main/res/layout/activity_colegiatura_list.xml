
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_dashboard_screen" tools:context=".colegiatura.ui.ColegiaturaListActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarColegiaturas" android:layout_width="0dp" android:layout_height="@dimen/dashboard_header_height" android:background="@color/dashboard_surface" android:elevation="1dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:navigationContentDescription="@string/colegiatura_volver" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/colegiatura_titulo" app:titleTextColor="@color/dashboard_text_primary"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/colegiaturaTopScroll" android:layout_width="0dp" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingStart="@dimen/dashboard_screen_padding" android:paddingTop="14dp" android:paddingEnd="@dimen/dashboard_screen_padding" android:paddingBottom="8dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbarColegiaturas">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_colegiatura_header" android:gravity="center_vertical" android:minHeight="128dp" android:orientation="horizontal" android:padding="@dimen/dashboard_card_padding">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="@string/colegiatura_titulo" android:textColor="@color/dashboard_on_primary" android:textSize="25sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="2dp" android:text="@string/colegiatura_subtitulo" android:textColor="@color/dashboard_on_primary_secondary" android:textSize="14sp"/>
                </LinearLayout>
                <FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_dashboard_avatar_light" android:padding="10dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ic_payment" app:tint="@color/white"/>
                </FrameLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/colegiaturaFiltersCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/dashboard_surface" app:cardCornerRadius="@dimen/dashboard_card_radius" app:cardElevation="4dp" app:strokeColor="@color/dashboard_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dashboard_card_padding">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-black" android:text="@string/colegiatura_filtros_titulo" android:textColor="@color/dashboard_text_primary" android:textSize="17sp" android:textStyle="bold"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAgregarColegiatura" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@string/colegiatura_accion_agregar" app:backgroundTint="@color/dashboard_payment" app:cornerRadius="8dp" app:icon="@drawable/ic_add" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/white"/>
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressColegiatura" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/dashboard_payment"/>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/colegiatura_estudiante_hint" app:boxCornerRadiusBottomEnd="8dp" app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusTopEnd="8dp" app:boxCornerRadiusTopStart="8dp" app:boxStrokeColor="@color/dashboard_payment" app:hintTextColor="@color/dashboard_payment">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actColegiaturaEstudiante" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:popupBackground="@color/dashboard_surface" android:textColor="@color/dashboard_text_primary" android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:hint="@string/colegiatura_ciclo_hint" app:boxStrokeColor="@color/dashboard_payment" app:hintTextColor="@color/dashboard_payment">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtColegiaturaCiclo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:hint="@string/colegiatura_estado_hint" app:boxStrokeColor="@color/dashboard_payment" app:hintTextColor="@color/dashboard_payment">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actColegiaturaEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:popupBackground="@color/dashboard_surface" android:textColor="@color/dashboard_text_primary"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/colegiatura_concepto_hint" app:boxStrokeColor="@color/dashboard_payment" app:hintTextColor="@color/dashboard_payment">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtColegiaturaConcepto" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBuscarColegiatura" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/colegiatura_accion_buscar" android:textAllCaps="false" app:backgroundTint="@color/dashboard_payment" app:cornerRadius="8dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleColegiaturaActivo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:selectionRequired="false" app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnActivoTodos" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Todas" android:textAllCaps="false" app:checkedIcon="@null"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnActivoSi" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Activas" android:textAllCaps="false" app:checkedIcon="@null"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnActivoNo" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Inactivas" android:textAllCaps="false" app:checkedIcon="@null"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerColegiaturas" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="@dimen/dashboard_screen_padding" android:paddingTop="8dp" android:paddingEnd="@dimen/dashboard_screen_padding" android:paddingBottom="8dp" app:layout_constraintBottom_toTopOf="@+id/colegiaturaPagination" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/colegiaturaTopScroll" tools:listitem="@layout/item_colegiatura"/>
    <TextView android:id="@+id/txtColegiaturaEstadoLista" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:textColor="@color/dashboard_text_secondary" android:textSize="14sp" android:visibility="gone" app:layout_constraintBottom_toTopOf="@id/colegiaturaPagination" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/colegiaturaTopScroll" tools:text="No se encontraron colegiaturas."/>
    <LinearLayout android:id="@+id/colegiaturaPagination" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/dashboard_screen_padding" android:paddingTop="6dp" android:paddingEnd="@dimen/dashboard_screen_padding" android:paddingBottom="10dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnColegiaturaAnterior" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/colegiatura_accion_anterior" android:textAllCaps="false" android:textColor="@color/dashboard_payment"/>
        <TextView android:id="@+id/txtColegiaturaPagina" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/dashboard_text_secondary" android:textSize="13sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnColegiaturaSiguiente" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/colegiatura_accion_siguiente" android:textAllCaps="false" android:textColor="@color/dashboard_payment"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>