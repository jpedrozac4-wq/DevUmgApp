
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/dashboard_surface"
    app:cardCornerRadius="@dimen/dashboard_card_radius"
    app:cardElevation="4dp"
    app:strokeColor="@color/dashboard_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dashboard_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dashboard_icon"
                android:padding="9dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_student"
                    app:tint="@color/dashboard_student" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEstudianteCodigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/dashboard_student"
                    android:textSize="15sp"
                    tools:text="20260001" />

                <TextView
                    android:id="@+id/txtEstudianteNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="18sp"
                    tools:text="Maria Jose Lopez Garcia" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEstudianteEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="Activo" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstudianteIdentificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="13sp"
            tools:text="Identificación: 1234567890101" />

        <TextView
            android:id="@+id/txtEstudianteCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="13sp"
            tools:text="maria.lopez@umg.edu.gt" />

        <TextView
            android:id="@+id/txtEstudianteVinculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="13sp"
            tools:text="Cuenta vinculada" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarEstudiante"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:contentDescription="@string/estudiante_accion_editar"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/dashboard_student" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiarEstadoEstudiante"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/estudiante_accion_inactivar"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_power"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/dashboard_student" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
