<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_screen"
    android:fitsSystemWindows="true"
    tools:context=".auth.ui.HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard_screen">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_header_height"
            android:background="@color/dashboard_surface"
            android:elevation="1dp"
            android:paddingStart="8dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationContentDescription="@string/nav_open_drawer"
            app:navigationIcon="@drawable/ic_menu">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/dashboard_title"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtToolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dashboard_subtitle"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtToolbarAvatar"
                android:layout_width="@dimen/dashboard_avatar_size"
                android:layout_height="@dimen/dashboard_avatar_size"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_dashboard_avatar"
                android:clickable="true"
                android:contentDescription="@string/dashboard_open_profile"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/dashboard_on_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="A" />
        </com.google.android.material.appbar.MaterialToolbar>

        <ScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:focusable="true"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            android:paddingStart="@dimen/dashboard_screen_padding"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/dashboard_screen_padding"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dashboard_section_spacing">

                <LinearLayout
                    android:id="@+id/dashboardHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dashboard_welcome_card_height"
                    android:background="@drawable/bg_dashboard_welcome_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/txtGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="15sp"
                        tools:text="Buenas tardes" />

                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="2"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Andrea López Martínez" />

                    <TextView
                        android:id="@+id/txtUserIdentity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:textColor="@color/dashboard_on_primary_secondary"
                        android:textSize="13sp"
                        tools:text="andrea@universidad.edu.gt
andrea.lopez" />

                    <TextView
                        android:id="@+id/txtAdminAccessSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/dashboard_on_primary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Acceso a 10 módulos de SGAU" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contextSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dashboard_section_spacing"
                    app:cardBackgroundColor="@color/dashboard_surface"
                    app:cardCornerRadius="@dimen/dashboard_card_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dashboard_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/txtContextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Resumen académico" />

                        <TextView
                            android:id="@+id/txtContextDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp"
                            tools:text="Información académica de la cuenta." />

                        <LinearLayout
                            android:id="@+id/contextActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="start"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnContextCourses"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_action_courses"
                                app:icon="@drawable/ic_course"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnContextGrades"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/dashboard_action_grades"
                                app:icon="@drawable/ic_grade"
                                app:iconGravity="textStart" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:background="@color/dashboard_border" />

                        <TextView
                            android:id="@+id/txtDailyTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/dashboard_daily_title"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDailyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp"
                            tools:text="El backend no proporciona horarios." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txtModulesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dashboard_section_spacing"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/dashboard_modules_title"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/modulesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_bottom_nav_height"
            android:layout_marginBottom="@dimen/dashboard_bottom_nav_margin_bottom"
            android:background="@color/dashboard_surface"
            android:elevation="8dp"
            app:itemIconTint="@color/nav_item_icon_color"
            app:itemPaddingBottom="8dp"
            app:itemPaddingTop="8dp"
            app:itemRippleColor="@color/dashboard_primary_light"
            app:itemTextAppearanceActive="@style/TextAppearance.SGAU.BottomNavigation"
            app:itemTextAppearanceInactive="@style/TextAppearance.SGAU.BottomNavigation"
            app:itemTextColor="@color/nav_item_text_color"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/menu_bottom_navigation" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/dashboard_surface"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/bg_nav_item_checked"
        app:itemIconTint="@color/nav_item_icon_color"
        app:itemTextColor="@color/nav_item_text_color"
        app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
