<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#F2F3F8" />
            <stroke
                android:width="1dp"
                android:color="@color/dashboard_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dashboard_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/dashboard_enrollment" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
