<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexusApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/bg_blue_darkest</item>
        <item name="android:statusBarColor">@color/bg_blue_darkest</item>
        <item name="android:navigationBarColor">@color/bg_blue_darkest</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.SGAU.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ProfileLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dashboard_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProfileValue" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/dashboard_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@color/dashboard_border</item>
    </style>
    <style name="Animation.SGAU.Dialog" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sgau_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/sgau_dialog_exit</item>
    </style>

    <style name="Theme.NexusApp.Home" parent="Theme.NexusApp">
        <item name="android:windowBackground">@drawable/bg_dashboard_screen</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@color/dashboard_surface</item>
        <item name="android:navigationBarColor">@color/dashboard_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
